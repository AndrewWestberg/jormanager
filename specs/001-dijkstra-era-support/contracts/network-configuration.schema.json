{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jormanager.invalid/schemas/network-configuration-manifest-v1.json",
  "title": "Network configuration ManifestV1",
  "type": "object",
  "required": ["resetId", "bundleId", "payload"],
  "additionalProperties": false,
  "properties": {
    "resetId": {"$ref": "#/$defs/hex64"},
    "bundleId": {"$ref": "#/$defs/hex64"},
    "payload": {"$ref": "#/$defs/payload"}
  },
  "$defs": {
    "hex64": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "nullableHex64": {"anyOf": [{"$ref": "#/$defs/hex64"}, {"type": "null"}]},
    "nullableNonemptyString": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "component": {
      "type": "object",
      "required": ["version", "revision", "binarySha256"],
      "additionalProperties": false,
      "properties": {
        "version": {"$ref": "#/$defs/nullableNonemptyString"},
        "revision": {"$ref": "#/$defs/nullableNonemptyString"},
        "binarySha256": {"$ref": "#/$defs/nullableHex64"}
      }
    },
    "identity": {
      "type": "object",
      "required": ["networkMagic", "systemStart", "genesisHashes"],
      "additionalProperties": false,
      "properties": {
        "networkMagic": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "systemStart": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "not": {"pattern": "[^0-9]"}},
        "genesisHashes": {
          "type": "object",
          "required": ["byron-genesis.json", "shelley-genesis.json", "alonzo-genesis.json", "conway-genesis.json", "dijkstra-genesis.json"],
          "additionalProperties": false,
          "properties": {
            "byron-genesis.json": {"$ref": "#/$defs/hex64"},
            "shelley-genesis.json": {"$ref": "#/$defs/hex64"},
            "alonzo-genesis.json": {"$ref": "#/$defs/hex64"},
            "conway-genesis.json": {"$ref": "#/$defs/hex64"},
            "dijkstra-genesis.json": {"$ref": "#/$defs/hex64"}
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "required": ["sha256", "sourceUrl"],
      "additionalProperties": false,
      "properties": {
        "sha256": {"$ref": "#/$defs/hex64"},
        "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https://(?:\\[[^\\]]+\\]|[^/?#@:\\[\\]]+)(?::[0-9]+)?(?:[/?][^#]*)?$", "not": {"pattern": "[\\u0000-\\u0020\\u007f]"}}
      }
    },
    "assets": {
      "type": "object",
      "required": ["byron-genesis.json", "shelley-genesis.json", "alonzo-genesis.json", "conway-genesis.json", "dijkstra-genesis.json", "config.json", "topology.json", "peer-snapshot.json"],
      "additionalProperties": false,
      "properties": {
        "byron-genesis.json": {"$ref": "#/$defs/asset"},
        "shelley-genesis.json": {"$ref": "#/$defs/asset"},
        "alonzo-genesis.json": {"$ref": "#/$defs/asset"},
        "conway-genesis.json": {"$ref": "#/$defs/asset"},
        "dijkstra-genesis.json": {"$ref": "#/$defs/asset"},
        "config.json": {"$ref": "#/$defs/asset"},
        "topology.json": {"$ref": "#/$defs/asset"},
        "peer-snapshot.json": {"$ref": "#/$defs/asset"}
      }
    },
    "payload": {
      "type": "object",
      "required": ["schemaVersion", "identity", "assets", "retrievedAt", "provenance"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {"type": "integer", "const": 1},
        "identity": {"$ref": "#/$defs/identity"},
        "assets": {"$ref": "#/$defs/assets"},
        "retrievedAt": {"type": "string", "minLength": 20, "maxLength": 20, "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "provenance": {
          "type": "object",
          "required": ["release", "components"],
          "additionalProperties": false,
          "properties": {
            "release": {"$ref": "#/$defs/nullableNonemptyString"},
            "components": {
              "type": "object",
              "required": ["node", "cli"],
              "additionalProperties": false,
              "properties": {
                "node": {"$ref": "#/$defs/component"},
                "cli": {"$ref": "#/$defs/component"}
              }
            }
          }
        }
      }
    }
  }
}
