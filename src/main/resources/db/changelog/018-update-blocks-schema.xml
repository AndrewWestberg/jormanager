<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.9.xsd">
    <changeSet id="018" author="Andrew Westberg">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*)
                FROM INFORMATION_SCHEMA.CONSTRAINTS
                WHERE CONSTRAINT_NAME='CONSTRAINT_74'
            </sqlCheck>
        </preConditions>
        <dropUniqueConstraint tableName="blocks" constraintName="CONSTRAINT_74" uniqueColumns="hash"/>
        
        <addColumn tableName="blocks">
            <!-- pending(default), completed, forged, orphaned -->
            <column name="status" type="varchar(255)" defaultValue="pending" defaultOnNull="true"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>