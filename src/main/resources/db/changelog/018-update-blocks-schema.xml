<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.9.xsd">
    <changeSet id="018" author="Andrew Westberg">
        <dropUniqueConstraint tableName="blocks" constraintName="blocks_hash_key" uniqueColumns="hash"/>

        <addColumn tableName="blocks">
            <!-- pending(default), completed, forged, orphaned -->
            <column name="status" type="varchar(255)" defaultValue="pending" defaultOnNull="true"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>