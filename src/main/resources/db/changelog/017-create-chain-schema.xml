<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.9.xsd">
    <changeSet id="017" author="Andrew Westberg">
        <createTable tableName="chain">
            <column name="id" type="int">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="block_number" type="int"/>
            <column name="slot_number" type="int"/>
            <column name="hash" type="varchar(255)"/>
            <column name="prev_hash" type="varchar(255)"/>
            <column name="node_vkey" type="varchar(255)"/>
            <column name="node_vrf_vkey" type="varchar(255)"/>
            <column name="eta_vrf_first" type="varchar(255)"/>
            <column name="eta_vrf_second" type="varchar(255)"/>
            <column name="leader_vrf_first" type="varchar(255)"/>
            <column name="leader_vrf_second" type="varchar(255)"/>
            <column name="block_size" type="int"/>
            <column name="block_body_hash" type="varchar(255)"/>
            <column name="opcert" type="varchar(255)"/>
            <column name="unknown1" type="int"/>
            <column name="kes_period" type="int"/>
            <column name="unknown2" type="varchar(255)"/>
            <column name="protocol_major_version" type="int"/>
            <column name="protocol_minor_version" type="int"/>
        </createTable>
    </changeSet>
</databaseChangeLog>